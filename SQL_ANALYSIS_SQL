-- DataCo Supply Chain Analytics - SQL Analysis
-- Author: Madhavan
-- Dataset: 180,519 orders

-- Q1: Total Late vs On-Time Orders
SELECT 
    Delivery_Status,
    COUNT(*) as order_count,
    ROUND(COUNT(*)*100.0/(SELECT COUNT(*) FROM dataco),2) as percentage
FROM dataco
GROUP BY Delivery_Status;

-- Q2: Late Delivery % by Shipping Mode (MAIN INSIGHT)
SELECT 
    Shipping_Mode,
    COUNT(*) as total_orders,
    SUM(CASE WHEN Delivery_Status = 'Late delivery' THEN 1 ELSE 0 END) as late_orders,
    ROUND(SUM(CASE WHEN Delivery_Status = 'Late delivery' THEN 1 ELSE 0 END)*100.0/COUNT(*),2) as late_percent
FROM dataco
GROUP BY Shipping_Mode
ORDER BY late_percent DESC;

-- Q3: Late Delivery by Order Region
SELECT 
    Order_Region,
    COUNT(*) as total_orders,
    SUM(CASE WHEN Delivery_Status = 'Late delivery' THEN 1 ELSE 0 END) as late_orders
FROM dataco
GROUP BY Order_Region
ORDER BY late_orders DESC;

-- Q4: Profit Impact of Late Delivery
SELECT 
    Delivery_Status,
    ROUND(SUM(Benefit_per_order),2) as total_profit,
    ROUND(AVG(Benefit_per_order),2) as avg_profit
FROM dataco
GROUP BY Delivery_Status;

-- Q5: Top 10 Products by Sales
SELECT 
    Product_Name,
    SUM(Sales_per_customer) as total_sales
FROM dataco
GROUP BY Product_Name
ORDER BY total_sales DESC
LIMIT 10;